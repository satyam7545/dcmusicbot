{
  "name": "harmonix-music-bot",
  "version": "1.0.0",
  "description": "High-fidelity Discord Music Bot with YouTube & Spotify streaming and modern real-time Web Dashboard",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:client": "vite",
    "build:client": "vite build",
    "build:server": "esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/index.js",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist/index.js",
    "deploy:commands": "tsx src/bot/deploy-commands.ts"
  },
  "dependencies": {
    "@discord-player/extractor": "^7.2.0",
    "@discordjs/voice": "^0.19.2",
    "@types/session-file-store": "^1.2.6",
    "axios": "^1.7.9",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "discord-player": "^7.2.0",
    "discord-player-youtubei": "^1.4.2",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.1",
    "express-rate-limit": "^8.7.4",
    "express-session": "^1.18.1",
    "ffmpeg-static": "^5.2.0",
    "helmet": "^8.3.0",
    "libsodium-wrappers": "^0.7.15",
    "lucide-react": "^0.468.0",
    "opusscript": "^0.1.1",
    "play-dl": "^1.9.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "session-file-store": "^1.5.0",
    "simple-ytdl-core": "^1.2.2",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.0",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.25.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
