# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here

# Spotify API Configuration (for metadata & playlist extraction)
# Get credentials at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# YouTube Cookie (optional - prevents YouTube bot blocks / IP limits)
# Paste cookie string or leave blank
YOUTUBE_COOKIE=

# Web Server & Dashboard Configuration
PORT=3000
DASHBOARD_URL=http://localhost:3000
SESSION_SECRET=harmonix_super_secret_session_key_change_in_production
NODE_ENV=development
